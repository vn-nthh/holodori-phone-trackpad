{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "doritrack",
  "version": "0.4.1",
  "identifier": "dev.doritrack.usbcontroller",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://127.0.0.1:1420",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "",
        "width": 430,
        "height": 320,
        "minWidth": 360,
        "minHeight": 300,
        "resizable": false,
        "decorations": true,
        "center": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; connect-src ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": false,
    "targets": "all"
  }
}
